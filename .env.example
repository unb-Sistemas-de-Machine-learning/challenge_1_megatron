# Copie para .env e preencha. O .env nunca é versionado.
# Sem chave de LLM o serviço sobe em modo degradado (só evidências, sem síntese).

# --- LLM: escolha UM provedor (API compatível com OpenAI) ---

# Groq (padrão). Chave gratuita em https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# GROQ_API_KEY= também é aceita no lugar de LLM_API_KEY
LLM_MODELOS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
LLM_MODELO_RAPIDO=llama-3.1-8b-instant

# Gemini. Chave gratuita em https://aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=<chave do AI Studio>
# LLM_MODELOS=gemini-2.5-flash
# LLM_MODELO_RAPIDO=gemini-2.5-flash

# Ollama local (docker compose --profile local-llm up).
# Baixe o modelo uma vez: docker compose exec ollama ollama pull qwen2.5:3b
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODELOS=qwen2.5:3b
# LLM_MODELO_RAPIDO=qwen2.5:3b

# --- PubMed (opcionais; aumentam o limite de requisições do NCBI) ---
NCBI_API_KEY=
NCBI_EMAIL=

# --- Serviço ---
# Caminho do banco SQLite (base de conhecimento + registro de consultas).
# VOF_BANCO=dados/vof.db
# Busca ao vivo no PubMed além da base local (1 liga, 0 desliga).
VOF_BUSCA_AO_VIVO=1
# Máximo de análises por minuto por cliente.
VOF_LIMITE_POR_MINUTO=12
# Validade do cache de consultas, em horas.
VOF_CACHE_HORAS=168
# Similaridade mínima (0 a 1) para um trecho da base contar como evidência.
VOF_SIMILARIDADE_MINIMA=0.45
# Modelo de embeddings (fastembed/ONNX).
# VOF_MODELO_EMBEDDING=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Classificador BERTimbau opcional (exige PyTorch: requirements-treino.txt).
# VOF_MODELO_RISCO=
